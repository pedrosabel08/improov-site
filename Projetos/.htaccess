Options -MultiViews -Indexes
RewriteEngine On

# This directory owns its rewrite rules; keep real legacy links before the router.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/+((?:improov-site/)?)Projetos/index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ /projetos [R=301,L,NC]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/+((?:improov-site/)?)Projetos/(aya-kar|ars-vie)/?(?:[?\s]) [NC]
RewriteRule ^(aya-kar|ars-vie)/?$ /projetos/$1 [R=301,L,NE,NC]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/+((?:improov-site/)?)Projetos/detalhes\.html\? [NC]
RewriteCond %{QUERY_STRING} (?:^|&)id=(aya-kar|ars-vie)(?:&|$) [NC]
RewriteRule ^detalhes\.html$ /projetos/%1? [R=301,L,NE,NC]

# The physical legacy directory must not win over the new /projetos route.
# An empty path here represents the physical legacy directory after DirectorySlash.
RewriteRule ^$ ../index.php [L]

# Keep direct access to legacy files only while the archive is still present.
# Any slug must be handled by the new PHP router.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ ../index.php [L]
