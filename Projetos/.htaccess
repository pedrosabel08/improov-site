Options -MultiViews -Indexes
RewriteEngine On
RewriteBase /improov-site/Projetos/

# This directory owns its rewrite rules; keep real legacy links before the router.
RewriteCond %{THE_REQUEST} \s/+improov-site/Projetos/index\.html(?:[?\s])
RewriteRule ^index\.html$ /improov-site/projetos/ [R=301,L,NC]
RewriteCond %{THE_REQUEST} \s/+improov-site/Projetos/(aya-kar|ars-vie)/?(?:[?\s])
RewriteRule ^(aya-kar|ars-vie)/?$ /improov-site/projetos/$1 [R=301,L,NE,NC]
RewriteCond %{THE_REQUEST} \s/+improov-site/Projetos/detalhes\.html\?
RewriteCond %{QUERY_STRING} (?:^|&)id=(aya-kar|ars-vie)(?:&|$) [NC]
RewriteRule ^detalhes\.html$ /improov-site/projetos/%1? [R=301,L,NE,NC]

# The physical legacy directory must not win over the new /projetos route.
# An empty path here represents /improov-site/projetos/ after DirectorySlash.
RewriteRule ^$ ../index.php [L]

# Keep direct access to legacy files only while the archive is still present.
# Any slug must be handled by the new PHP router.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ ../index.php [L]
